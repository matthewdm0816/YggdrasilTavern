TREECHAT_DATABASE_URL=sqlite:///./treechat.db
TREECHAT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LAN clients use Vite's same-origin /api proxy while the backend stays on
# loopback, so LAN mode does not require a wildcard CORS origin.

# Optional account bootstrap for existing LAN installations. You can also enable
# multi-user login locally through Settings -> User profile and login. Once an
# account registry exists, login remains required regardless of this flag.
# scripts/start.ps1 -Lan injects the username, password, and a fresh 32-byte
# secret into the child process without writing them here. For manual startup,
# all three values are required for bootstrap; never commit real credentials.
# After bootstrap, passwords are managed in the UI and survive restarts.
YGGDRASIL_AUTH_ENABLED=false
# YGGDRASIL_AUTH_USERNAME=owner
# YGGDRASIL_AUTH_PASSWORD=replace-with-a-strong-password
# YGGDRASIL_AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# YGGDRASIL_AUTH_SESSION_TTL_SECONDS=604800
# YGGDRASIL_AUTH_COOKIE_SECURE=false

# API keys entered in the UI are stored in the local SQLite database.
# Legacy api_key_env profiles read variables already exported by the backend process.
